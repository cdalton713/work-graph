{
  "name": "work-graph",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite",
    "service:dev": "node server/testing/service-dev.ts",
    "start": "node server/main.ts",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "pnpm build && playwright test --grep-invert @shots",
    "shots": "pnpm build && playwright test --grep @shots"
  },
  "dependencies": {
    "@hono/node-server": "1.19.18",
    "@hono/node-ws": "1.3.0",
    "@xyflow/react": "^13.0.2",
    "elkjs": "^0.12.1",
    "hono": "4.13.16",
    "ioredis": "6.0.0",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "ws": "8.23.0"
  }
}
